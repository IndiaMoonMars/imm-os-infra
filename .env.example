# ── IMM-OS Infrastructure — Environment Variables Template ───────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme

# ── InfluxDB ─────────────────────────────────────────────────────
INFLUX_USER=admin
INFLUX_PASSWORD=changeme123
INFLUX_TOKEN=your-super-secret-influx-token-here

# ── Mosquitto (MQTT) ─────────────────────────────────────────────
# See the MQTT section at the end of this file.

# ── Kafka ────────────────────────────────────────────────────────
KAFKA_USER=admin
KAFKA_PASSWORD=changeme

# ── Keycloak (Auth) ──────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# ── Auth ─────────────────────────────────────────────────────────
# Public URL the browser uses for Keycloak; must match the token "iss"
KEYCLOAK_ISSUER=http://imm.local/auth/realms/IndiaMoonMars
# Shared secret for internal service-to-service calls (docker network only).
# Generate with: openssl rand -hex 32
IMM_SERVICE_TOKEN=change-me-internal-service-token
# Client secret for edge nodes (Keycloak client imm-edge, role edge_device).
# Required. Put the same value in /etc/imm-os/edge.env on each RPi/Jetson.
IMM_EDGE_CLIENT_SECRET=
# Shared secret for the psych sleep webhook (Garmin/Fitbit). Leave empty to
# keep the webhook disabled. Send as X-IMM-Webhook-Token or ?token=.
SLEEP_WEBHOOK_TOKEN=

# ── Sensor simulator ───────────────────────────────────────────────
# As real sensors come online, stop simulating them (comma list of
# "sensor" for every simulated node, or "node_id:sensor"), then run
#   docker compose up -d sensor-sim
# e.g. SIM_DISABLED_SENSORS=node-rpi-01:bme280,node-rpi-01:scd40
SIM_DISABLED_SENSORS=

# ── MQTT (Mosquitto) ─────────────────────────────────────────────
# Required. One password per MQTT user; topics each may use are in
# mosquitto/config/acl. Generate each with: openssl rand -hex 24
# MQTT_EDGE_PASSWORD also goes in /etc/imm-os/edge.env on every edge node.
MQTT_EDGE_PASSWORD=
MQTT_ECLSS_PASSWORD=
MQTT_INGEST_PASSWORD=
MQTT_SIM_PASSWORD=
