# ── Secrets — NEVER commit these ────────────────────────────────
.env
*.pem
*.key
*.crt
kubeconfig
.kube/

# ── K3s runtime ──────────────────────────────────────────────────
k3s/data/
k3s/token

# ── Mosquitto runtime data ───────────────────────────────────────
mosquitto/data/
mosquitto/log/
mosquitto/certs/

# ── Backups (scripts/backup, BACKUP_DIR): database contents, never commit ──
backups/
# ── Mission archive (MISSION_ARCHIVE_DIR): every sol's readings, never commit ──
archive/
vv/reports/

# ── Terraform ────────────────────────────────────────────────────
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example

# ── Ansible ──────────────────────────────────────────────────────
*.retry
ansible/.vault_pass

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
