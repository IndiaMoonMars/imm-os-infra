{
  "realm": "IndiaMoonMars",
  "displayName": "India Moon Mars — IMM OS",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 86400,
  "roles": {
    "realm": [
      { "name": "crew", "description": "Habitat crew member (analog astronaut)" },
      { "name": "commander", "description": "Mission commander (habitat side)" },
      { "name": "flight_surgeon", "description": "Flight surgeon — access to crew medical, journal and psych data" },
      { "name": "mcc_operator", "description": "Mission Control Centre operator" }
    ]
  },
  "clients": [
    {
      "clientId": "imm-frontend",
      "name": "IMM OS Crew / MCC web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://imm.local",
      "baseUrl": "/",
      "redirectUris": ["http://imm.local/*", "http://localhost:3000/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "imm-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "imm-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
